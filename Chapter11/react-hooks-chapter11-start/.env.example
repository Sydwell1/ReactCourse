# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-todos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-todos
VITE_FIREBASE_APP_ID=demo-app
# true = use the local Emulator Suite, false = use your real Firebase project
VITE_USE_EMULATORS=true
